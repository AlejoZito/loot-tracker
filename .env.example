# Copy this file to .env and fill in the values below.
# Full step-by-step instructions for every value here: quickstart/README.md

# ── Datasource ───────────────────────────────────────────────────────────────
# xlsx (default): a local .xlsx file, no Google Cloud setup needed — the app seeds
#   it from server/resources/sample-sheet-db/ on first run and writes back to your
#   own copy at server/data/ (gitignored) from then on. Fastest way to try the app.
# google-sheets: a real Google Sheet — see quickstart/README.md. Set this to persist
#   data centrally / access it from multiple devices. GOOGLE_SHEETS_ID becomes
#   required when you do.
DATA_SOURCE=xlsx
# DATA_SOURCE=google-sheets

# ── Auth: two login accounts, one per household budget-user slot ───────────
# Auth - User A (maps to budget-user slot "userA")
AUTH_USERNAME_A=user1
AUTH_PASSWORD_A=your_password_here

# Auth - User B (maps to budget-user slot "userB")
AUTH_USERNAME_B=user2
AUTH_PASSWORD_B=your_password_here

# ── Budget-user identity ────────────────────────────────────────────────────
# The id written into the sheet's "usuario" column and embedded in the JWT.
# Keep these short and stable — changing them after you have data means old
# rows in your sheet won't match the new id. Defaults: user-a / user-b.
BUDGET_USER_A=user-a
BUDGET_USER_B=user-b

# Display names shown in the UI. Defaults: "User A" / "User B".
BUDGET_USER_A_LABEL=User A
BUDGET_USER_B_LABEL=User B

# ── Auth secret ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your_random_secret_here

# ── Google Sheets — only used when DATA_SOURCE=google-sheets ───────────────
GOOGLE_SHEETS_ID=your_sheet_id_here
# Local dev: path to your service-account credentials file
GOOGLE_CREDENTIALS_PATH=./server/credentials.json
# Vercel / hosted deploys: paste the full JSON content of credentials.json as a single line
GOOGLE_CREDENTIALS_JSON=

# Declared for forward compatibility but not yet read anywhere — sheet/tab names are
# currently fixed ('expenses', 'expenses-categories', 'habits', ...) in the repository
# layer regardless of what you set here. Leave these unset until that's wired through.
EXPENSES_SHEET_NAME=expenses
CATEGORIES_SHEET_NAME=expenses-categories
HABITS_SHEET_NAME=habits
HABITS_CATEGORIES_SHEET_NAME=habits-categories
SUMMARY_SHEET_NAME=summary
SUMMARY_BY_CATEGORIES_SHEET_NAME=summary_by_categories

# ── Local xlsx datasource — only used when DATA_SOURCE=xlsx (the default) ──
# Usually no need to touch these.
# DATA_SOURCE_XLSX_PATH=./server/data/expensesDb.xlsx
# DATA_SOURCE_XLSX_SEED_PATH=./server/resources/sample-sheet-db/expensesDb_mock.xlsx

# ── Optional: E2E tests ──────────────────────────────────────────────────────
# A throwaway spreadsheet used only by `npm run test:e2e`. Never point this at
# your real data — the test suite writes and deletes rows in it.
E2E_SPREADSHEET_ID=your_test_sheet_id_here
